# Copy to .env.development.local for local development. Nothing here is secret:
# Vertex AI and Firestore authenticate with Application Default Credentials
# (`gcloud auth application-default login`), so there is no API key to set.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
KREDAL_FIRESTORE_DB=kredal

# Optional — model ids per tier (defaults in src/lib/agentic/models.ts).
# KREDAL_MODEL_FAST=gemini-3.8-flash
# KREDAL_MODEL_FAST_FALLBACK=gemini-3.5-flash
# KREDAL_MODEL_STRONG=gemini-3.1-pro-preview
# KREDAL_MODEL_STABLE=gemini-2.5-pro

# The original Kredal app (/app) used Supabase. The agentic demo does not;
# leave these blank and /app stays gated behind /login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
